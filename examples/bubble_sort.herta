// массивы передаются по значению, поэтому функция возвращает
// отсортированную копию, а не правит оригинал на месте

module bubble_sort;

type Index = int32;  // type-alias, синоним для int32

fn bubble_sort(arr: [int32; 5]) [int32; 5] {
    // arr — локальная копия, можно изменять без побочных эффектов
    var i: Index = 0;
    while i < 4 {
        var j: Index = 0;
        while j < 4 - i {
            if arr[j] > arr[j + 1] {
                var tmp: int32 = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = tmp;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return arr;
}

fn main() int32 {
    var arr: [int32; 5] = [5, 3, 1, 4, 2];
    arr = bubble_sort(arr);

    // ожидается 1..5 столбиком
    var k: int32 = 0;
    while k < 5 {
        print(arr[k]);
        k = k + 1;
    }

    // проверка результата сортировки
    let expected: [int32; 5] = [1, 2, 3, 4, 5];
    assert(arr == expected);

    return 0;
}
