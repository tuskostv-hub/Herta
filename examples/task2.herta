// задание 2: крестики-нолики, проверка победителя на доске 3×3

module task2;

fn check_winner(board: [[char; 3]; 3]) int32 {
    // строки
    var i: int32 = 0;
    while i < 3 {
        if board[i][0] != '.' && board[i][0] == board[i][1] && board[i][1] == board[i][2] {
            if board[i][0] == 'X' { return 1; }
            return 2;
        }
        i = i + 1;
    }

    // столбцы
    var j: int32 = 0;
    while j < 3 {
        if board[0][j] != '.' && board[0][j] == board[1][j] && board[1][j] == board[2][j] {
            if board[0][j] == 'X' { return 1; }
            return 2;
        }
        j = j + 1;
    }

    // диагональ слева направо
    if board[0][0] != '.' && board[0][0] == board[1][1] && board[1][1] == board[2][2] {
        if board[0][0] == 'X' { return 1; }
        return 2;
    }

    // диагональ справа налево
    if board[0][2] != '.' && board[0][2] == board[1][1] && board[1][1] == board[2][0] {
        if board[0][2] == 'X' { return 1; }
        return 2;
    }

    return 0;
}

fn main() int32 {
    // X выиграл по строке
    let b1: [[char; 3]; 3] = [
        ['X', 'X', 'X'],
        ['.', 'O', '.'],
        ['O', '.', '.']
    ];
    print(check_winner(b1));

    // O выиграл по столбцу
    let b2: [[char; 3]; 3] = [
        ['X', 'O', '.'],
        ['X', 'O', '.'],
        ['.', 'O', '.']
    ];
    print(check_winner(b2));

    // X выиграл по главной диагонали
    let b3: [[char; 3]; 3] = [
        ['X', 'O', 'O'],
        ['.', 'X', '.'],
        ['.', '.', 'X']
    ];
    print(check_winner(b3));

    // O выиграл по побочной диагонали
    let b4: [[char; 3]; 3] = [
        ['.', '.', 'O'],
        ['.', 'O', '.'],
        ['O', 'X', 'X']
    ];
    print(check_winner(b4));

    // ничья, победителя нет
    let b5: [[char; 3]; 3] = [
        ['X', 'O', 'X'],
        ['O', 'X', 'O'],
        ['O', 'X', 'O']
    ];
    print(check_winner(b5));
    
    return 0;
}
