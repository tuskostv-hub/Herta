// задание 1: классификатор чисел

module task1;

fn is_prime(n: int32) bool {
    if n < 2 { return false; }
    var i: int32 = 2;
    while i * i <= n {
        if n % i == 0 { return false; }
        i = i + 1;
    }
    return true;
}

fn classify_number(n: int32) void {
    let even: bool = n % 2 == 0;

    if even && n > 100 {
        print("BigEven");
    } else if even && n >= 10 && n <= 100 {
        print("MediumEven");
    } else if even && n < 10 {
        print("SmallEven");
    } else if n >= 100 && n <= 999 {
        print("OddThreeDigit");
    } else if n < 0 {
        print("NegativeOdd");
    } else if is_prime(n) {
        print("PrimeOdd");
    } else {
        print("Other");
    }
}

fn main() int32 {

    let arr: [int32; 7] = [200, 42, 4, 123, -7, 13, 9];
    var j: int32 = 0;
    while j < 7 {
        classify_number(arr[j]);
        j = j + 1;
    }
    return 0;
}

