// задание 6: проверка корректности даты

module task6;

fn is_leap(year: int32) bool {
    if year % 400 == 0 { return true; }
    if year % 100 == 0 { return false; }
    if year % 4 == 0 { return true; }
    return false;
}

fn days_in_month(month: int32, year: int32) int32 {
    if month == 1 || month == 3 || month == 5 || month == 7
        || month == 8 || month == 10 || month == 12 {
        return 31;
    }
    if month == 4 || month == 6 || month == 9 || month == 11 {
        return 30;
    }
    if month == 2 {
        if is_leap(year) { return 29; }
        return 28;
    }
    return 0;
}

fn is_valid_date(day: int32, month: int32, year: int32) int32 {
    if year < 1 { return 0; }
    if month < 1 || month > 12 { return 0; }
    let dim: int32 = days_in_month(month, year);
    if day < 1 || day > dim { return 0; }
    return 1;
}

fn main() int32 {
    // обычные валидные даты
    print(is_valid_date(15, 6, 2024));   // 1
    print(is_valid_date(31, 12, 2024));  // 1
    print(is_valid_date(1, 1, 2024));    // 1

    // 29 февраля и високосные годы
    print(is_valid_date(29, 2, 2024));   // 1, 2024 делится на 4
    print(is_valid_date(29, 2, 2023));   // 0, 2023 не делится на 4
    print(is_valid_date(29, 2, 2000));   // 1, делится на 400, високосный
    print(is_valid_date(29, 2, 1900));   // 0, делится на 100, но не на 400
    print(is_valid_date(29, 2, 1600));   // 1, делится на 400

    // день вне диапазона месяца
    print(is_valid_date(31, 4, 2024));   // 0, в апреле 30 дней
    print(is_valid_date(30, 2, 2024));   // 0, в феврале максимум 29

    // некорректные месяц или день
    print(is_valid_date(0, 1, 2024));    // 0
    print(is_valid_date(1, 13, 2024));   // 0
    print(is_valid_date(1, 0, 2024));    // 0

    return 0;
}
