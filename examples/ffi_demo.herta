// вызов функций libc через extern, плюс работа с указателями

module ffi_demo;

// extern объявляет внешнюю функцию, её тело берётся из libc
extern fn puts(s: *byte) int32;
extern fn printf(fmt: *byte, x: int32) int32;

fn main() int32 {
    // вывод строки через puts
    puts("=== ffi_demo ===");

    // адрес локальной переменной
    var x: int32 = 42;
    var p: *int32 = &x;
    assert(*p == 42);
    *p = 99;
    assert(*p == 99);

    // нулевой указатель, разыменование поймает рантайм
    var nope: *int32 = null;

    // форматированный вывод через printf
    printf("printf via FFI: x = %d\n", *p);

    return 0;
}
