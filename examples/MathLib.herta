// Мини-«std»: библиотечный модуль арифметических утилит на самом Herta.
// Демонстрирует A.2.13 (модули) и A.3.6 (контроль видимости).
// Не претендует на полный A.3.11 — для этого нужны generics/pointers/memory.

module MathLib;

pub fn abs(x: int32) int32 {
    if x < 0 { return -x; }
    return x;
}

pub fn min(a: int32, b: int32) int32 {
    if a < b { return a; }
    return b;
}

pub fn max(a: int32, b: int32) int32 {
    if a > b { return a; }
    return b;
}

pub fn clamp(x: int32, lo: int32, hi: int32) int32 {
    return min(max(x, lo), hi);
}

// Приватная: используется внутри MathLib, не видна извне.
fn pow_helper(base: int32, exp: int32, acc: int32) int32 {
    if exp == 0 { return acc; }
    return pow_helper(base, exp - 1, acc * base);
}

pub fn pow(base: int32, exp: int32) int32 {
    return pow_helper(base, exp, 1);
}
