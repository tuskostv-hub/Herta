// A.3.14 Модульная система с контролем видимости.
// pub при объявлении делает символ видимым через `M.name`. Без pub
// семантика отвергает обращение из другого модуля. Те же правила для
// функций, структур (типы, литералы, методы) и пространств имён.
//
// Соседние файлы bad_*.herta демонстрируют, что попытка обратиться к
// приватному имени даёт ошибку компиляции.

module a3_14_visibility;

import Lib;

fn main() int32 {
    // pub fn: можно.
    let s: int32 = Lib.add(10, 32);
    assert(s == 42);
    print(s);

    // pub fn, которая внутри сама зовёт приватную — это разрешено.
    let d: int32 = Lib.double(7);
    assert(d == 14);
    print(d);

    // pub-структура из модуля: квалифицированный тип, литерал,
    // статический и инстанс-методы.
    let c: Lib.Counter = Lib.Counter.make(41);
    assert(c.tick() == 42);
    let c2: Lib.Counter = Lib.Counter { value: 9 };
    assert(c2.tick() == 10);

    // pub-функция внутри pub-namespace: Lib.Util.triple.
    let t: int32 = Lib.Util.triple(14);
    assert(t == 42);
    print(t);

    print("a3.14 ok");
    return 0;
}
