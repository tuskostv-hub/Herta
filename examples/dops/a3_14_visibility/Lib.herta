// Библиотечный модуль с явным разделением public/private.

module Lib;

// Публичные функции.
pub fn add(a: int32, b: int32) int32 {
    return a + b;
}

pub fn double(x: int32) int32 {
    return secret_helper(x);  // внутри модуля приватное доступно.
}

// Приватная функция: для внешнего мира `Lib.secret_helper` запрещён.
fn secret_helper(x: int32) int32 {
    return x * 2;
}

// pub-структура: тип виден извне как Lib.Counter, литерал и методы
// доступны из других модулей.
pub struct Counter { value: int32 }

impl Counter {
    pub fn make(start: int32) Counter {
        return Counter { value: start };
    }
    pub fn tick(self: Counter) int32 {
        return self.value + 1;
    }
    // Приватный метод: доступен только методам самого Counter.
    fn helper(self: Counter) int32 {
        return self.value * 2;
    }
}

// pub-namespace: извне доступно Lib.Util.<pub-имя>.
pub namespace Util {
    pub fn triple(x: int32) int32 { return x * 3; }
    fn inner() int32 { return 0; }   // не экспортируется
}

// Приватный тип.
struct Hidden { tag: int32 }
