fn main() int32 {
    while true {
        herta();   print(""); delay();
        herta_2(); print(""); delay();
        herta_3(); print(""); delay();
        herta_4(); print(""); delay();
        herta_5(); print(""); delay();
        herta_6(); print(""); delay();
    }
    return 0;
}
