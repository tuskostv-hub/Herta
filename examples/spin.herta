// Чиби-Герта в стиле halftone-ASCII портрета, 7 кадров.
// Каждый print дописывает \n, поэтому портрет «моргает» по мере скролла.
//
// Ctrl+C для выхода. Задержка через встроенный sleep_ms (через nanosleep
// в рантайме), CPU не нагружается.

module spin;

fn delay() void {
    sleep_ms(80);
    return;
}

fn herta() void {
    print("###########################################+--------+########################################");
    print("#####################################+....................-+#################################");
    print("##################################-.......-..--...............+##############################");
    print("################################-......--.......................+############################");
    print("##############################-..........------+++++++-...........+##########################");
    print("############################-....------++-------+++++++++-....-....-#########################");
    print("###########################-..--...-++++++++++++++++++--+++-.........+#######################");
    print("##########################..+-..-++++++++++++++++++++++..++++-.--.....+######################");
    print("########################+.-++--+++++++++++++..++++++++++..++++-.----...+#####################");
    print("########################..+++++++++++++++--+-..-++-.-++++..-+++-.-......#####################");
    print("#######################-.+-.-++-.+.-+++++..-+-...-+-.-++++-..+++-.......+####################");
    print("######################+.-+-.++-.--.-+++++-..-+-.--..-..-++++-.-+++-.....-####################");
    print("######################-.++..-...--..--++++...-+-.--.......--++-..---.....-+##################");
    print("######################.-++...-+.--....-++--.........+-..----.........---+-..-+###############");
    print("#####################+.-++...-...........-+#+..----.-##+.-++++-.-+++++++++++-..-#############");
    print("######################.-++..+##..----.-######+.+#++--####-.+++++..-++++++++++++-..+##########");
    print("######################-.++-..##-.++++-.#######+.---.+#####+..++++-...-+++++++++++-.+#########");
    print("######################+.-++..###.-+++.-##########+##########-..-+--+--.........-++-.#########");
    print("#######################-.+++-.+##-...-####-.+##############+.--..............-+++++.-########");
    print("#######################-..--+-..+#########################-.-+++--...........-+++++-.########");
    print("#######################-...-.....+##################++-.............-##-.##+..+++++-.########");
    print("#######################+++.-###############++--........-....--......###-.....++++++.-########");
    print("#########################+-...............---+#+...................-###+.++-..-+++-.#########");
    print("##################-..........-.............-+-....-....--..........+####.-+-.-+++-.+#########");
    print("################-..+#......................++.......-+---..........+####+.-.-++-.-###########");
    print("##############+..-.+#+.............................--..-+.......---.........-+-.+############");
    print("################++--##-........................+#+...--.............-..-+++-..+##############");
    print("###################.-##+................+#+-.-##+-....................-+-..-#################");
    print("###################+.-###-................--++-..........------------...-+###################");
    print("#####################-.--..+##+-......-................................-#####################");
    print("###########################+-.......--..+##-...............................-#################");
    print("######################.....--++....-....+###..--....---........................+#############");
    print("#######################+--.......-.....-#####..--.......+-........................+##########");
    print("##############################-........+######+-++..--..+##+.........................+#######");
    print("##############################+........+############-..#######+........................+#####");
    print("##############################-........######################-.-+.......................-####");
    return;
}

